# CVE Fix Automation Tool - Environment Configuration
# Copy this file to .env and fill in your values

# API Configuration
PORT=3000
NODE_ENV=development

# OpenAI Configuration (optional - enables LLM agent mode)
OPENAI_API_KEY=

# Docker Configuration
DOCKER_HOST=unix:///var/run/docker.sock

# Docker Hub Configuration (optional - higher rate limits)
DOCKER_HUB_USERNAME=
DOCKER_HUB_PASSWORD=

# GitHub Configuration (optional - for PR creation)
GITHUB_TOKEN=

# Trivy Configuration
TRIVY_CACHE_DIR=./trivy-cache
TRIVY_TIMEOUT=300000

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/cve-fix.log

# Performance Configuration
MAX_CONCURRENT_SCANS=3
BUILD_TIMEOUT=600000
RUN_TIMEOUT=30000

# Version Search Strategy
VERSION_SEARCH_STRATEGY=sequential 